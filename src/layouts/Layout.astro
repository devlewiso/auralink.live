---
import "../styles/global.css";

interface Props {
	title: string;
	description?: string;
}

const {
	title,
	description = "AuraLink AI Security - Advanced Cybersecurity powered by Artificial Intelligence.",
} = Astro.props;
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="generator" content={Astro.generator} />
		<title>{title} | AuraLink AI Security</title>
		<meta name="description" content={description} />
		<!-- SEO -->
		<meta name="keywords" content="AI cybersecurity, red team security, penetration testing, 24/7 threat monitoring, incident response, AuraLink, AI security services" />
		<meta name="robots" content="index, follow" />
		<link rel="canonical" href={`https://auralink.live`} />
		<!-- Open Graph -->
		<meta property="og:type" content="website" />
		<meta property="og:site_name" content="AuraLink AI Security" />
		<meta property="og:title" content={`${title} | AuraLink AI Security`} />
		<meta property="og:description" content={description} />
		<meta property="og:image" content="https://auralink.live/og-image.png" />
		<meta property="og:url" content="https://auralink.live" />
		<!-- Twitter -->
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={`${title} | AuraLink AI Security`} />
		<meta name="twitter:description" content={description} />
		<meta name="twitter:image" content="https://auralink.live/og-image.png" />
		<!-- AI Search / LLM context -->
		<meta name="ai:description" content="AuraLink AI Security provides proactive, AI-driven cybersecurity services including 24/7 monitoring, penetration testing, and incident response. We stop threats before they happen." />
		<meta name="ai:services" content="24/7 AI Monitoring, Penetration Testing, Incident Response, Free Security Scan, CISO as a Service" />
		<meta name="ai:pricing" content="Plans from $99/mo. Free security scan available. No credit card required." />
		<meta name="ai:contact" content="+1 567 406 1261 | devlewiso@gmail.com | auralink.live" />

		<!-- Google Fonts -->
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Space+Grotesk:wght@500;700&display=swap"
			rel="stylesheet"
		/>

		<!-- Google tag (gtag.js) -->
		<script
			async
			src="https://www.googletagmanager.com/gtag/js?id=G-40MN1DF52C"
		></script>
		<script>
			window.dataLayer = window.dataLayer || [];
			function gtag() {
				dataLayer.push(arguments);
			}
			gtag("js", new Date());

			gtag("config", "G-40MN1DF52C");
		</script>

		<!-- Chat Messenger (CES) -->
		<script
			defer
			src="https://www.gstatic.com/chat-messenger/sdk/prod/v1.16/chat-messenger.js"
		></script>
		<link
			rel="stylesheet"
			href="https://www.gstatic.com/chat-messenger/sdk/prod/v1.16/themes/chat-messenger-default.css"
		/>
		<link
			rel="stylesheet"
			href="https://www.gstatic.com/chat-messenger/sdk/prod/v1.16/themes/chat-messenger-layout.css"
		/>
	</head>
	<body class="bg-[#020617] text-slate-200">
		<slot />

		<!-- Tars AI Bot (CES) -->
		<script>
			function registerChatContext() {
				chatSdk.registerContext(
					chatSdk.prebuilts.ces.createContext({
						deploymentName:
							"projects/1062264788608/locations/us/apps/919d66ab-0067-42c3-a22a-90f87156c173/deployments/1300ea6c-6a2e-4d62-af1b-7134cba55e6a",
						tokenBroker: {
							enableTokenBroker: true,
							enableRecaptcha: false,
						},
					}),
				);
			}
			// The SDK may finish loading (and fire this event) before this
			// script runs, so check for it directly instead of only
			// listening for the event — otherwise registerContext never
			// runs and the widget silently falls back to a broken legacy path.
			if (window.chatSdk) {
				registerChatContext();
			} else {
				window.addEventListener("chat-messenger-loaded", registerChatContext);
			}
		</script>
		<!-- Update url-allowlist with a comma-separated list of origins allowed to render images -->
		<chat-messenger url-allowlist="*" render-mode="slide-in">
			<chat-messenger-container
				chat-title="Ryan"
				chat-title-icon="https://gstatic.com/dialogflow-console/common/assets/ccai-favicons/conversational_agents.png"
				enable-file-upload
				enable-audio-input
			>
				<chat-reset-session-button
					slot="titlebar-actions"
					title-text="Start new chat"
				></chat-reset-session-button>
				<chat-toggle-dialog-button
					slot="titlebar-actions"
					title-text-expanded="Collapse"
					title-text-collapsed="Expand"
				></chat-toggle-dialog-button>
				<chat-messenger-close-button
					slot="titlebar-actions"
					title-text="Close"
				></chat-messenger-close-button>
				<chat-messenger-entry-point-button
					slot="entry-point"
				></chat-messenger-entry-point-button>
			</chat-messenger-container>
		</chat-messenger>
		<script>
			window.addEventListener("chat-messenger-loaded", () => {
				const entryButton = document.querySelector(
					"chat-messenger-entry-point-button",
				);
				const closeButton = document.querySelector(
					"chat-messenger-close-button",
				);
				entryButton?.addEventListener("click", () => {
					entryButton.style.display = "none";
				});
				closeButton?.addEventListener("click", () => {
					entryButton.style.display = "";
				});
			});
		</script>

		<style is:global>
			chat-messenger {
				z-index: 999;
				position: fixed;
				bottom: 16px;
				right: 16px;
			}

			chat-messenger-entry-point-button {
				position: fixed;
				top: auto;
				left: auto;
				bottom: 16px;
				right: 16px;
				z-index: 1000;
			}
		</style>
	</body>
</html>
