---
import Layout from "../layouts/Layout.astro";
import ParticlesBackground from "../components/react/ParticlesBackground";
import SecurityScanner from "../components/react/SecurityScanner";
import Header from "../components/Header.astro";
---

<Layout title="Home">
	<main class="relative min-h-screen overflow-hidden bg-[#020617]">
		<!-- Particles Background -->
		<ParticlesBackground client:load />

		<!-- Background glow effects -->
		<div
			class="absolute top-0 -left-4 w-72 h-72 bg-emerald-500 rounded-full mix-blend-multiply filter blur-3xl opacity-10 animate-blob"
		>
		</div>
		<div
			class="absolute top-0 -right-4 w-72 h-72 bg-cyan-500 rounded-full mix-blend-multiply filter blur-3xl opacity-10 animate-blob animation-delay-2000"
		>
		</div>

		<!-- Navigation -->
		<Header currentPath="/" />

		<!-- Hero Section -->
		<section
			class="container mx-auto px-6 pt-20 pb-16 text-center relative z-10"
		>
			<div
				class="inline-block px-4 py-1.5 mb-6 border border-emerald-500/30 bg-emerald-500/10 rounded-full"
			>
				<span
					class="text-emerald-400 text-xs font-bold uppercase tracking-wider"
					>AI-Powered Defense Systems</span
				>
			</div>

			<h1
				class="text-5xl md:text-7xl font-bold mb-8 max-w-4xl mx-auto leading-tight"
			>
				Security that thinks <span class="text-gradient"
					>faster than hackers</span
				>
			</h1>

			<p
				class="text-slate-400 text-lg md:text-xl max-w-2xl mx-auto mb-12"
			>
				Protecting infrastructure with proactive AI-driven intelligence.
				We stop threats <strong class="text-white">before</strong> they happen.
			</p>

			<div class="flex flex-col sm:flex-row gap-4 justify-center mb-16">
				<a
					href="#scanner"
					class="bg-emerald-500 hover:bg-emerald-400 text-black px-8 py-4 rounded-xl font-bold text-lg transition-all transform hover:scale-105 active:scale-95 glow-primary"
				>
					Start Free Security Scan
				</a>
				<a
					href="/services"
					class="border border-emerald-500 text-emerald-400 px-8 py-4 rounded-xl font-bold text-lg hover:bg-emerald-500/10 transition-all"
				>
					View Solutions
				</a>
			</div>
		</section>

		<!-- The Watcher Section -->
		<section class="container mx-auto px-6 py-16 relative z-10">
			<div class="flex flex-col md:flex-row items-center gap-10 max-w-5xl mx-auto">
				<div class="flex-1">
					<div class="inline-block px-3 py-1 mb-4 border border-red-500/30 bg-red-500/10 rounded-full">
						<span class="text-red-400 text-xs font-bold uppercase tracking-wider">Red Team // The Watcher</span>
					</div>
					<h2 class="text-3xl md:text-4xl font-bold mb-4">We think like <span class="text-gradient">the adversary</span></h2>
					<p class="text-slate-400">Our red team operators blend into the shadows. Suited, masked, relentless — they probe your defenses before the real threat actors do. AuraLink's Watcher sees everything.</p>
				</div>
				<div class="flex-1 flex justify-center">
					<img
						src="https://images.unsplash.com/photo-1558618666-fcd25c85cd64?w=480&h=560&fit=crop&q=80"
						alt="The Watcher - AuraLink Red Team Operator"
						class="rounded-2xl border border-emerald-500/20 shadow-2xl max-w-xs w-full object-cover"
						width="480" height="560"
						loading="lazy"
					/>
				</div>
			</div>
		</section>

		<!-- Free Security Scanner Section -->
		<section
			id="scanner"
			class="container mx-auto px-6 py-20 relative z-10"
		>
			<div class="text-center mb-12">
				<div
					class="inline-block px-4 py-1.5 mb-6 border border-emerald-500/30 bg-emerald-500/10 rounded-full"
				>
					<span
						class="text-emerald-400 text-xs font-bold uppercase tracking-wider"
						>Free Security Analysis</span
					>
				</div>
				<h2 class="text-4xl md:text-5xl font-bold mb-4">
					Test Your <span class="text-gradient">Security Posture</span
					>
				</h2>
				<p class="text-slate-400 text-lg max-w-2xl mx-auto">
					Get an instant AI-powered security analysis of your website.
					No credit card required.
				</p>
			</div>

			<SecurityScanner client:load />
		</section>

		<!-- Features Section -->
		<section class="container mx-auto px-6 py-20 relative z-10">
			<div class="grid md:grid-cols-3 gap-8 max-w-6xl mx-auto">
				<div
					class="bg-slate-900/50 backdrop-blur-sm border border-slate-800 rounded-2xl p-8 hover:border-emerald-500/50 transition-all"
				>
					<div
						class="w-12 h-12 bg-emerald-500/10 rounded-xl flex items-center justify-center mb-6"
					>
						<svg
							class="w-6 h-6 text-emerald-400"
							fill="none"
							stroke="currentColor"
							viewBox="0 0 24 24"
						>
							<path
								stroke-linecap="round"
								stroke-linejoin="round"
								stroke-width="2"
								d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"></path>
							<path
								stroke-linecap="round"
								stroke-linejoin="round"
								stroke-width="2"
								d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"
							></path>
						</svg>
					</div>
					<h3 class="text-2xl font-bold mb-4">24/7 AI Monitoring</h3>
					<p class="text-slate-400">
						Our AI never sleeps. Continuous threat detection with
						machine learning algorithms that identify anomalies in
						real-time.
					</p>
				</div>

				<div
					class="bg-slate-900/50 backdrop-blur-sm border border-slate-800 rounded-2xl p-8 hover:border-emerald-500/50 transition-all"
				>
					<div
						class="w-12 h-12 bg-emerald-500/10 rounded-xl flex items-center justify-center mb-6"
					>
						<svg
							class="w-6 h-6 text-emerald-400"
							fill="none"
							stroke="currentColor"
							viewBox="0 0 24 24"
						>
							<path
								stroke-linecap="round"
								stroke-linejoin="round"
								stroke-width="2"
								d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"
							></path>
						</svg>
					</div>
					<h3 class="text-2xl font-bold mb-4">Penetration Testing</h3>
					<p class="text-slate-400">
						We hack you ethically before the bad actors do.
						AI-powered vulnerability scanning combined with expert
						manual validation.
					</p>
				</div>

				<div
					class="bg-slate-900/50 backdrop-blur-sm border border-slate-800 rounded-2xl p-8 hover:border-emerald-500/50 transition-all"
				>
					<div
						class="w-12 h-12 bg-emerald-500/10 rounded-xl flex items-center justify-center mb-6"
					>
						<svg
							class="w-6 h-6 text-emerald-400"
							fill="none"
							stroke="currentColor"
							viewBox="0 0 24 24"
						>
							<path
								stroke-linecap="round"
								stroke-linejoin="round"
								stroke-width="2"
								d="M13 10V3L4 14h7v7l9-11h-7z"></path>
						</svg>
					</div>
					<h3 class="text-2xl font-bold mb-4">Incident Response</h3>
					<p class="text-slate-400">
						When seconds count, our AI-assisted incident response
						team neutralizes threats with precision and speed.
					</p>
				</div>
			</div>
		</section>

		<!-- Watcher Team Grid -->
		<section class="container mx-auto px-6 py-16 relative z-10">
			<div class="text-center mb-10">
				<h2 class="text-3xl font-bold">The <span class="text-gradient">Shadow Operators</span></h2>
				<p class="text-slate-400 mt-2 text-sm">Elite red team specialists who never stop watching</p>
			</div>
			<div class="grid grid-cols-2 md:grid-cols-4 gap-4 max-w-4xl mx-auto">
				<img src="https://images.unsplash.com/photo-1526374965328-7f61d4dc18c5?w=300&h=380&fit=crop&q=80" alt="AuraLink Red Team Operator" class="rounded-xl border border-slate-800 w-full object-cover aspect-[3/4]" loading="lazy" />
				<img src="https://images.unsplash.com/photo-1542831371-29b0f74f9713?w=300&h=380&fit=crop&q=80" alt="AuraLink Security Specialist" class="rounded-xl border border-slate-800 w-full object-cover aspect-[3/4] md:mt-8" loading="lazy" />
				<img src="https://images.unsplash.com/photo-1504639725590-34d0984388bd?w=300&h=380&fit=crop&q=80" alt="AuraLink Threat Hunter" class="rounded-xl border border-slate-800 w-full object-cover aspect-[3/4]" loading="lazy" />
				<img src="https://images.unsplash.com/photo-1555066931-4365d14bab8c?w=300&h=380&fit=crop&q=80" alt="AuraLink Penetration Tester" class="rounded-xl border border-slate-800 w-full object-cover aspect-[3/4] md:mt-8" loading="lazy" />
			</div>
		</section>

		<!-- ===== LEAD CAPTURE SECTION ===== -->
		<section class="container mx-auto px-6 py-20 relative z-10">
			<div class="max-w-2xl mx-auto bg-slate-900/60 backdrop-blur-sm border border-emerald-500/30 rounded-2xl p-10">
				<div class="text-center mb-8">
					<div class="inline-block px-4 py-1.5 mb-4 border border-emerald-500/30 bg-emerald-500/10 rounded-full">
						<span class="text-emerald-400 text-xs font-bold uppercase tracking-wider">Free Security Consultation</span>
					</div>
					<h2 class="text-3xl md:text-4xl font-bold mb-3">
						Get Your <span class="text-gradient">Free Assessment</span>
					</h2>
					<p class="text-slate-400">
						Tell us about your infrastructure. We'll respond within 24 hours with a personalized security plan.
					</p>
				</div>

				<div id="hero-form-success" class="hidden mb-6 p-4 bg-emerald-500/10 border border-emerald-500/30 rounded-lg text-center">
					<p class="text-emerald-400 font-medium">✅ Got it! We'll reach out within 24 hours.</p>
				</div>
				<div id="hero-form-error" class="hidden mb-6 p-4 bg-red-500/10 border border-red-500/30 rounded-lg">
					<p class="text-red-400 font-medium" id="hero-form-error-msg">Something went wrong. Please try again.</p>
				</div>

				<form id="hero-lead-form" class="space-y-4">
					<div class="grid md:grid-cols-2 gap-4">
						<div>
							<label for="hero-name" class="block text-sm font-medium text-slate-300 mb-1">Full Name *</label>
							<input
								type="text"
								id="hero-name"
								name="name"
								required
								class="w-full px-4 py-3 bg-slate-800/50 border border-slate-700 rounded-lg focus:outline-none focus:border-emerald-500 text-white transition-colors placeholder-slate-500"
								placeholder="Jane Smith"
							/>
						</div>
						<div>
							<label for="hero-email" class="block text-sm font-medium text-slate-300 mb-1">Work Email *</label>
							<input
								type="email"
								id="hero-email"
								name="email"
								required
								class="w-full px-4 py-3 bg-slate-800/50 border border-slate-700 rounded-lg focus:outline-none focus:border-emerald-500 text-white transition-colors placeholder-slate-500"
								placeholder="jane@company.com"
							/>
						</div>
					</div>
					<div>
						<label for="hero-company" class="block text-sm font-medium text-slate-300 mb-1">Company</label>
						<input
							type="text"
							id="hero-company"
							name="company"
							class="w-full px-4 py-3 bg-slate-800/50 border border-slate-700 rounded-lg focus:outline-none focus:border-emerald-500 text-white transition-colors placeholder-slate-500"
							placeholder="Your Company Inc."
						/>
					</div>
					<input type="hidden" name="service" value="other" />
					<input type="hidden" name="message" value="Lead from homepage hero form - Free Assessment request." />
					<button
						type="submit"
						id="hero-submit-btn"
						class="w-full bg-emerald-500 hover:bg-emerald-400 text-black px-8 py-4 rounded-xl font-bold text-lg transition-all transform hover:scale-105 active:scale-95 glow-primary"
					>
						Get My Free Security Assessment →
					</button>
					<p class="text-center text-slate-500 text-xs">No spam. No credit card. Just security expertise.</p>
				</form>
			</div>
		</section>

		<!-- Motto Section -->
		<section class="container mx-auto px-6 py-16 relative z-10">
			<div class="text-center">
				<p class="text-emerald-400 text-sm font-mono tracking-wider">
					Active Defense // Artificial Intelligence // Borderless
					Security
				</p>
			</div>
		</section>
	</main>
</Layout>

<script>
	const heroForm = document.getElementById('hero-lead-form') as HTMLFormElement;
	const heroSuccess = document.getElementById('hero-form-success')!;
	const heroErrorBox = document.getElementById('hero-form-error')!;
	const heroErrorMsg = document.getElementById('hero-form-error-msg')!;
	const heroSubmitBtn = document.getElementById('hero-submit-btn') as HTMLButtonElement;

	heroForm?.addEventListener('submit', async (e) => {
		e.preventDefault();
		heroSuccess.classList.add('hidden');
		heroErrorBox.classList.add('hidden');
		heroSubmitBtn.disabled = true;
		heroSubmitBtn.textContent = 'Sending...';

		const data = Object.fromEntries(new FormData(heroForm));

		try {
			const res = await fetch('/api/contact', {
				method: 'POST',
				headers: { 'Content-Type': 'application/json' },
				body: JSON.stringify(data),
			});
			const json = await res.json();

			if (res.ok && json.success) {
				heroForm.reset();
				heroSuccess.classList.remove('hidden');
			} else {
				heroErrorMsg.textContent = json.error || 'Something went wrong.';
				heroErrorBox.classList.remove('hidden');
			}
		} catch {
			heroErrorMsg.textContent = 'Network error. Please try again.';
			heroErrorBox.classList.remove('hidden');
		} finally {
			heroSubmitBtn.disabled = false;
			heroSubmitBtn.textContent = 'Get My Free Security Assessment →';
		}
	});
</script>

<style>
	/* Any component-specific styles go here */
</style>
