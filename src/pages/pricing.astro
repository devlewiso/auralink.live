---
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import pricingData from "../data/pricing.json";

const { pentestPackages, comparisonTable, addOnServices, faq } = pricingData;
---

<Layout
    title="Pentest Pricing — AuraLink Security"
    description="Transparent, fixed-price penetration testing. Know exactly what you're getting, when you'll get it, and what it costs. No surprises."
>
    <main class="min-h-screen bg-[#020617]">
        <Header currentPath="/pricing" />

        <!-- Hero -->
        <section class="container mx-auto px-6 pt-20 pb-10 text-center">
            <div class="inline-block px-4 py-1.5 mb-6 border border-emerald-500/30 bg-emerald-500/10 rounded-full">
                <span class="text-emerald-400 text-xs font-bold uppercase tracking-wider">Fixed-Price Penetration Testing</span>
            </div>
            <h1 class="text-5xl md:text-6xl font-bold mb-6 max-w-4xl mx-auto">
                Know Exactly What <span class="text-gradient">You're Getting</span>
            </h1>
            <p class="text-slate-400 text-lg max-w-2xl mx-auto mb-4">
                One-time security audits. Fixed price, defined scope, guaranteed delivery window.
                No hourly billing surprises. No vague "it depends" quotes.
            </p>
            <!-- Value anchor -->
            <p class="text-slate-500 text-sm max-w-xl mx-auto">
                The average cost of a data breach is <span class="text-rose-400 font-semibold">$4.45M</span> globally.
                Finding it first costs a fraction of that.
            </p>
        </section>

        <!-- Pricing Cards -->
        <section class="container mx-auto px-6 py-12">
            <div class="grid md:grid-cols-3 gap-8 max-w-6xl mx-auto items-start">
                {pentestPackages.map((pkg) => (
                    <div
                        class={`backdrop-blur-sm rounded-2xl p-8 relative transition-all flex flex-col ${
                            pkg.featured
                                ? "bg-gradient-to-b from-emerald-500/10 to-slate-900/50 border-2 border-emerald-500 md:scale-105"
                                : "bg-slate-900/50 border border-slate-800 hover:border-emerald-500/50"
                        }`}
                    >
                        {pkg.featured && (
                            <div class="absolute -top-4 left-1/2 -translate-x-1/2 bg-emerald-500 text-black px-4 py-1 rounded-full text-xs font-bold uppercase">
                                {pkg.badge}
                            </div>
                        )}

                        <!-- Name + badge -->
                        <div class="mb-5">
                            <div class="flex items-center gap-2 mb-1">
                                <h3 class="text-2xl font-bold">{pkg.name}</h3>
                                {!pkg.featured && (
                                    <span class="text-xs font-bold px-2 py-0.5 rounded-full bg-slate-700 text-slate-300">
                                        {pkg.badge}
                                    </span>
                                )}
                            </div>
                            <p class="text-slate-400 text-sm">{pkg.description}</p>
                        </div>

                        <!-- Scope pill — what they're buying in plain language -->
                        <div class="mb-5 bg-slate-800/70 rounded-xl px-4 py-3 border border-slate-700/50">
                            <p class="text-emerald-400 text-xs font-bold uppercase tracking-wider mb-1">What's covered</p>
                            <p class="text-white text-sm font-medium">{pkg.scope}</p>
                            <p class="text-slate-500 text-xs mt-1">{pkg.scopeTooltip}</p>
                        </div>

                        <!-- Price + delivery -->
                        <div class="mb-6">
                            <div class="flex items-baseline gap-2">
                                <span class={`font-bold ${pkg.price === "Custom" ? "text-4xl text-emerald-400" : "text-5xl"}`}>
                                    {pkg.price}
                                </span>
                            </div>
                            <p class="text-slate-500 text-sm mt-1">{pkg.priceNote}</p>
                            <!-- Delivery time — critical trust signal -->
                            <div class="flex items-center gap-2 mt-3">
                                <svg class="w-4 h-4 text-cyan-400 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
                                </svg>
                                <span class="text-cyan-400 text-sm font-semibold">{pkg.delivery}</span>
                            </div>
                        </div>

                        <!-- Deliverables -->
                        <ul class="space-y-2.5 mb-6 flex-1">
                            {pkg.deliverables.map((item) => (
                                <li class="flex items-start">
                                    <svg class="w-4 h-4 text-emerald-400 mr-2.5 mt-0.5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                                    </svg>
                                    <span class="text-slate-300 text-sm">{item}</span>
                                </li>
                            ))}
                        </ul>

                        <!-- Not included note -->
                        {pkg.notIncluded && (
                            <p class="text-slate-500 text-xs mb-5 border-t border-slate-800 pt-4">
                                {pkg.notIncluded}
                            </p>
                        )}

                        <!-- CTA -->
                        <a
                            href="/contact"
                            class={`block w-full text-center px-6 py-3 rounded-xl font-bold transition-all mt-auto ${
                                pkg.ctaStyle === "primary"
                                    ? "bg-emerald-500 text-black hover:bg-emerald-400 glow-primary"
                                    : "border border-emerald-500 text-emerald-400 hover:bg-emerald-500/10"
                            }`}
                        >
                            {pkg.cta}
                        </a>
                    </div>
                ))}
            </div>

            <!-- Scope clarifier note -->
            <p class="text-center text-slate-600 text-xs mt-8 max-w-xl mx-auto">
                All audits require a signed authorization form before work begins.
                Prices are per-project, not per month. No recurring charges unless you opt into a monitoring retainer.
            </p>
        </section>

        <!-- Plan Comparison Table -->
        <section class="container mx-auto px-6 py-16">
            <div class="text-center mb-10">
                <h2 class="text-3xl font-bold mb-3">Compare All Plans</h2>
                <p class="text-slate-400 text-sm">Everything included in each audit — no hidden extras.</p>
            </div>

            <div class="max-w-5xl mx-auto overflow-x-auto">
                <table class="w-full border-collapse">
                    <!-- Header -->
                    <thead>
                        <tr>
                            <th class="text-left py-4 px-5 text-slate-500 text-sm font-normal w-2/5"></th>
                            <th class="py-4 px-5 text-center">
                                <div class="text-white font-bold">Starter</div>
                                <div class="text-emerald-400 font-bold text-lg">$399</div>
                            </th>
                            <th class="py-4 px-5 text-center bg-emerald-500/5 border-x border-emerald-500/20 rounded-t-xl">
                                <div class="text-emerald-400 text-xs font-bold uppercase tracking-wider mb-1">Most Popular</div>
                                <div class="text-white font-bold">Business</div>
                                <div class="text-emerald-400 font-bold text-lg">$799</div>
                            </th>
                            <th class="py-4 px-5 text-center">
                                <div class="text-white font-bold">Enterprise</div>
                                <div class="text-emerald-400 font-bold text-lg">Custom</div>
                            </th>
                        </tr>
                    </thead>

                    <tbody>
                        {comparisonTable.map((section) => (
                            <>
                                <!-- Category header row -->
                                <tr>
                                    <td colspan="4" class="pt-6 pb-2 px-5">
                                        <span class="text-xs font-bold uppercase tracking-widest text-slate-500">
                                            {section.category}
                                        </span>
                                    </td>
                                </tr>

                                <!-- Feature rows -->
                                {section.rows.map((row, i) => (
                                    <tr class={`border-t border-slate-800/60 ${i % 2 === 0 ? "" : "bg-slate-900/20"}`}>
                                        <td class="py-3.5 px-5 text-slate-300 text-sm">{row.feature}</td>

                                        <!-- Starter -->
                                        <td class="py-3.5 px-5 text-center">
                                            {row.starter === true ? (
                                                <span class="inline-flex items-center justify-center">
                                                    <svg class="w-5 h-5 text-emerald-400" viewBox="0 0 20 20" fill="currentColor">
                                                        <circle cx="10" cy="10" r="10" />
                                                        <path fill="#020617" d="M6 10l3 3 5-5" stroke="#020617" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" fill="none"/>
                                                    </svg>
                                                </span>
                                            ) : row.starter === false ? (
                                                <span class="inline-block w-4 h-0.5 bg-slate-700 rounded mx-auto"></span>
                                            ) : (
                                                <span class="text-emerald-400 text-xs font-semibold">{row.starter}</span>
                                            )}
                                        </td>

                                        <!-- Business -->
                                        <td class="py-3.5 px-5 text-center bg-emerald-500/5 border-x border-emerald-500/20">
                                            {row.business === true ? (
                                                <span class="inline-flex items-center justify-center">
                                                    <svg class="w-5 h-5 text-emerald-400" viewBox="0 0 20 20" fill="currentColor">
                                                        <circle cx="10" cy="10" r="10" />
                                                        <path fill="#020617" d="M6 10l3 3 5-5" stroke="#020617" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" fill="none"/>
                                                    </svg>
                                                </span>
                                            ) : row.business === false ? (
                                                <span class="inline-block w-4 h-0.5 bg-slate-700 rounded mx-auto"></span>
                                            ) : (
                                                <span class="text-emerald-400 text-xs font-semibold">{row.business}</span>
                                            )}
                                        </td>

                                        <!-- Enterprise -->
                                        <td class="py-3.5 px-5 text-center">
                                            {row.enterprise === true ? (
                                                <span class="inline-flex items-center justify-center">
                                                    <svg class="w-5 h-5 text-emerald-400" viewBox="0 0 20 20" fill="currentColor">
                                                        <circle cx="10" cy="10" r="10" />
                                                        <path fill="#020617" d="M6 10l3 3 5-5" stroke="#020617" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" fill="none"/>
                                                    </svg>
                                                </span>
                                            ) : row.enterprise === false ? (
                                                <span class="inline-block w-4 h-0.5 bg-slate-700 rounded mx-auto"></span>
                                            ) : (
                                                <span class="text-emerald-400 text-xs font-semibold">{row.enterprise}</span>
                                            )}
                                        </td>
                                    </tr>
                                ))}
                            </>
                        ))}

                        <!-- CTA row -->
                        <tr class="border-t border-slate-800">
                            <td class="py-6 px-5"></td>
                            <td class="py-6 px-5 text-center">
                                <a href="/contact" class="inline-block border border-emerald-500 text-emerald-400 px-5 py-2.5 rounded-xl text-sm font-bold hover:bg-emerald-500/10 transition-all">
                                    Get Started
                                </a>
                            </td>
                            <td class="py-6 px-5 text-center bg-emerald-500/5 border-x border-b border-emerald-500/20 rounded-b-xl">
                                <a href="/contact" class="inline-block bg-emerald-500 text-black px-5 py-2.5 rounded-xl text-sm font-bold hover:bg-emerald-400 transition-all glow-primary">
                                    Get Started
                                </a>
                            </td>
                            <td class="py-6 px-5 text-center">
                                <a href="/contact" class="inline-block border border-emerald-500 text-emerald-400 px-5 py-2.5 rounded-xl text-sm font-bold hover:bg-emerald-500/10 transition-all">
                                    Contact Sales
                                </a>
                            </td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </section>

        <!-- Add-On Services — clearly separated from main audits -->
        <section class="container mx-auto px-6 py-16">
            <div class="text-center mb-10">
                <h2 class="text-3xl font-bold mb-3">Add-On Services</h2>
                <p class="text-slate-400 text-sm max-w-lg mx-auto">
                    Need something beyond a pentest audit? These services can be booked standalone or added to any package.
                </p>
            </div>
            <div class="grid md:grid-cols-3 gap-6 max-w-5xl mx-auto">
                {addOnServices.map((svc) => (
                    <div class="bg-slate-900/30 border border-slate-800 rounded-xl p-6">
                        <h3 class="text-lg font-bold mb-1">{svc.name}</h3>
                        <div class="flex items-baseline gap-2 mb-3">
                            <span class="text-2xl font-bold text-emerald-400">{svc.price}</span>
                            {svc.priceAlt && (
                                <span class="text-slate-500 text-sm">{svc.priceAlt}</span>
                            )}
                        </div>
                        <p class="text-slate-400 text-sm">{svc.description}</p>
                    </div>
                ))}
            </div>
        </section>

        <!-- FAQ — now actually relevant to what we sell -->
        <section class="container mx-auto px-6 py-16">
            <div class="max-w-3xl mx-auto">
                <h2 class="text-3xl font-bold mb-10 text-center">Common Questions</h2>
                <div class="space-y-4">
                    {faq.map((item) => (
                        <div class="bg-slate-900/30 border border-slate-800 rounded-xl p-6">
                            <h3 class="text-base font-bold mb-2 text-white">{item.q}</h3>
                            <p class="text-slate-400 text-sm leading-relaxed">{item.a}</p>
                        </div>
                    ))}
                </div>
            </div>
        </section>

        <!-- Trust strip — honest claim, Business+ only -->
        <section class="container mx-auto px-6 py-10">
            <div class="flex flex-col sm:flex-row items-center gap-6 max-w-4xl mx-auto border border-red-500/20 bg-red-500/5 rounded-2xl p-8">
                <div class="flex gap-3 shrink-0">
                    <img src="https://images.unsplash.com/photo-1542831371-29b0f74f9713?w=200&h=260&fit=crop&q=80" alt="AuraLink Red Team Operator" class="rounded-xl border border-red-500/20 w-24 object-cover" loading="lazy" />
                    <img src="https://images.unsplash.com/photo-1555066931-4365d14bab8c?w=200&h=260&fit=crop&q=80" alt="AuraLink Security Analyst" class="rounded-xl border border-red-500/20 w-24 object-cover mt-5" loading="lazy" />
                </div>
                <div>
                    <p class="text-red-400 text-xs font-bold uppercase tracking-wider mb-2">// Offensive Testing — Business & Enterprise Plans</p>
                    <p class="text-slate-300 text-sm">Business and Enterprise audits include adversarial testing: our analysts actively attempt to exploit vulnerabilities the way a real attacker would — not just scan for them. You get the attacker's perspective, documented and actionable.</p>
                </div>
            </div>
        </section>

        <!-- CTA -->
        <section class="container mx-auto px-6 py-20">
            <div class="bg-gradient-to-r from-emerald-500/10 to-cyan-500/10 border border-emerald-500/30 rounded-3xl p-12 text-center">
                <h2 class="text-4xl font-bold mb-4">Not Sure Which Audit Fits?</h2>
                <p class="text-slate-400 text-lg mb-2 max-w-xl mx-auto">
                    Book a free 30-minute scoping call. We'll tell you exactly which package covers your risk — no upsell pressure.
                </p>
                <p class="text-slate-500 text-sm mb-8">Typical call result: you know your package, scope, price, and start date before you hang up.</p>
                <a
                    href="/contact"
                    class="inline-block bg-emerald-500 hover:bg-emerald-400 text-black px-8 py-4 rounded-xl font-bold text-lg transition-all glow-primary"
                >
                    Book Free Scoping Call
                </a>
            </div>
        </section>
    </main>
</Layout>
