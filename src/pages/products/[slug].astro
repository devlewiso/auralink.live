---
import Layout from "../../layouts/Layout.astro";
import Header from "../../components/Header.astro";
import { products } from "../../data/products";

export const prerender = true;

export async function getStaticPaths() {
    return products.map((product) => ({
        params: { slug: product.id },
        props: { product }
    }));
}

const { product } = Astro.props;
---

<Layout
    title={`${product.name} | AuraLink Merch`}
    description={product.description}
>
    <main class="min-h-screen bg-[#020617]">
        <!-- Navigation -->
        <Header currentPath="/products" />

        <!-- Product Detail -->
        <section class="container mx-auto px-6 py-20">
            <div class="max-w-6xl mx-auto">
                <!-- Breadcrumb -->
                <nav class="mb-8">
                    <a href="/products" class="text-slate-400 hover:text-emerald-400 transition-colors text-sm">
                        ← Back to Products
                    </a>
                </nav>

                <div class="grid md:grid-cols-2 gap-12">
                    <!-- Product Image -->
                    <div class="bg-slate-900/50 backdrop-blur-sm border border-slate-800 rounded-2xl overflow-hidden">
                        <img
                            src={product.image}
                            alt={product.name}
                            class="w-full h-full object-cover"
                        />
                    </div>

                    <!-- Product Info -->
                    <div class="flex flex-col justify-center">
                        <h1 class="text-4xl md:text-5xl font-bold mb-4">{product.name}</h1>
                        <p class="text-emerald-400 text-3xl font-bold mb-6">${product.price}</p>
                        <p class="text-slate-300 text-lg mb-8">{product.longDescription}</p>

                        <!-- Features -->
                        <div class="mb-8">
                            <h3 class="text-lg font-bold mb-4 text-slate-200">Features</h3>
                            <ul class="space-y-2">
                                {product.features.map((feature) => (
                                    <li class="flex items-center text-slate-400">
                                        <span class="text-emerald-400 mr-3">✓</span>
                                        {feature}
                                    </li>
                                ))}
                            </ul>
                        </div>

                        <!-- Specs -->
                        <div class="mb-8">
                            <h3 class="text-lg font-bold mb-4 text-slate-200">Specifications</h3>
                            <div class="bg-slate-900/50 rounded-xl p-4 border border-slate-800">
                                {Object.entries(product.specs).map(([key, value]) => (
                                    <div class="flex justify-between py-2 border-b border-slate-800 last:border-0">
                                        <span class="text-slate-400 capitalize">{key}</span>
                                        <span class="text-slate-200">{value}</span>
                                    </div>
                                ))}
                            </div>
                        </div>

                        <!-- CTA -->
                        <div class="flex gap-4">
                            <a
                                href="/contact"
                                class="flex-1 bg-emerald-500 hover:bg-emerald-400 text-black px-8 py-4 rounded-xl font-bold text-lg transition-all glow-primary text-center"
                            >
                                Order Now
                            </a>
                            <a
                                href="/products"
                                class="px-8 py-4 rounded-xl font-bold text-lg border border-slate-700 hover:border-emerald-500/50 text-slate-300 hover:text-emerald-400 transition-all"
                            >
                                Browse More
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        </section>

        <!-- Related Products -->
        <section class="container mx-auto px-6 py-16">
            <h2 class="text-2xl font-bold mb-8 text-center">You Might Also Like</h2>
            <div class="grid md:grid-cols-3 gap-8 max-w-5xl mx-auto">
                {products.filter(p => p.id !== product.id).slice(0, 3).map((related) => (
                    <a
                        href={`/products/${related.id}`}
                        class="bg-slate-900/50 backdrop-blur-sm border border-slate-800 rounded-2xl overflow-hidden hover:border-emerald-500/50 transition-all group"
                    >
                        <div class="aspect-square bg-slate-800/50 overflow-hidden">
                            <img
                                src={related.image}
                                alt={related.name}
                                class="w-full h-full object-cover group-hover:scale-105 transition-transform"
                                loading="lazy"
                            />
                        </div>
                        <div class="p-6">
                            <h3 class="text-xl font-bold mb-2">{related.name}</h3>
                            <p class="text-emerald-400 font-bold text-lg">${related.price}</p>
                        </div>
                    </a>
                ))}
            </div>
        </section>
    </main>
</Layout>
