---
import Layout from "../../layouts/Layout.astro";
import Header from "../../components/Header.astro";
import { getCollection } from "astro:content";

const products = [
    {
        id: "tactical-cap",
        name: "Tactical Cap",
        price: 35,
        image: "/merch/tactical-cap.jpg",
        description: "Black cap with embroidered logo in emerald green. Tactical style, universal fit.",
        features: ["Premium cotton blend", "Adjustable strap", "Embroidered logo", "UV protection"]
    },
    {
        id: "zero-day-tshirt",
        name: "Zero Day T-Shirt",
        price: 45,
        image: "/merch/zero-day-tshirt.jpg",
        description: "Premium black cotton. 'Zero Day' design on chest, AuraLink logo on back.",
        features: ["100% organic cotton", "Screen printed design", "Pre-shrunk fabric", "Unisex fit"]
    },
    {
        id: "encrypted-hoodie",
        name: "Encrypted Hoodie",
        price: 75,
        image: "/merch/encrypted-hoodie.jpg",
        description: "Black hoodie with encrypted code design. Kangaroo pocket, soft interior.",
        features: ["Heavyweight fleece", "Encrypted code print", "Kangaroo pocket", "Drawstring hood"]
    },
    {
        id: "hex-keychain",
        name: "Hex Keychain",
        price: 15,
        image: "/merch/hex-keychain.jpg",
        description: "Metal keychain in hexagonal chip shape. Matte black finish with engraved logo.",
        features: ["Aircraft-grade aluminum", "Matte black coating", "Laser engraved", "Split ring included"]
    },
    {
        id: "sticker-pack",
        name: "Sticker Pack",
        price: 10,
        image: "/merch/sticker-pack.jpg",
        description: "Pack of 5 water-resistant stickers. Logos, icons and cyber-security phrases.",
        features: ["Waterproof vinyl", "UV resistant", "5 unique designs", "3 inch size"]
    },
    {
        id: "terminal-mug",
        name: "Terminal Mug",
        price: 25,
        image: "/merch/terminal-mug.jpg",
        description: "Matte black ceramic mug. Command terminal design in phosphor green.",
        features: ["15oz capacity", "Dishwasher safe", "Matte finish", "Command prompt design"]
    }
];
---

<Layout
    title="Products | AuraLink"
    description="Exclusive cyber-security merchandise. Tactical caps, encrypted hoodies, hex keychains and more."
>
    <main class="min-h-screen bg-[#020617]">
        <!-- Navigation -->
        <Header currentPath="/products" />

        <!-- Hero Section -->
        <section class="container mx-auto px-6 pt-20 pb-16 text-center">
            <div
                class="inline-block px-4 py-1.5 mb-6 border border-cyan-500/30 bg-cyan-500/10 rounded-full"
            >
                <span
                    class="text-cyan-400 text-xs font-bold uppercase tracking-wider"
                    >AuraLink Merch</span
                >
            </div>
            <h1 class="text-5xl md:text-6xl font-bold mb-6 max-w-4xl mx-auto">
                Carry <span class="text-gradient">Security</span> With You
            </h1>
            <p class="text-slate-400 text-lg max-w-2xl mx-auto">
                Exclusive products designed for the cyber community. Premium quality, unique style.
            </p>
        </section>

        <!-- Products Grid -->
        <section class="container mx-auto px-6 py-16">
            <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-8 max-w-6xl mx-auto">
                {products.map((product) => (
                    <a
                        href={`/products/${product.id}`}
                        class="bg-slate-900/50 backdrop-blur-sm border border-slate-800 rounded-2xl overflow-hidden hover:border-emerald-500/50 transition-all group"
                    >
                        <div class="aspect-square bg-slate-800/50 overflow-hidden">
                            <img
                                src={product.image}
                                alt={product.name}
                                class="w-full h-full object-cover group-hover:scale-105 transition-transform"
                                loading="lazy"
                            />
                        </div>
                        <div class="p-6">
                            <h3 class="text-xl font-bold mb-2">{product.name}</h3>
                            <p class="text-slate-400 text-sm mb-4 line-clamp-2">
                                {product.description}
                            </p>
                            <div class="flex items-center justify-between">
                                <span class="text-emerald-400 font-bold text-lg">
                                    ${product.price}
                                </span>
                                <span class="text-emerald-400 text-sm font-medium group-hover:translate-x-1 transition-transform">
                                    View Details →
                                </span>
                            </div>
                        </div>
                    </a>
                ))}
            </div>
        </section>

        <!-- CTA Section -->
        <section class="container mx-auto px-6 py-20">
            <div
                class="bg-gradient-to-r from-emerald-500/10 to-cyan-500/10 border border-emerald-500/30 rounded-3xl p-12 text-center"
            >
                <h2 class="text-4xl font-bold mb-6">
                    Bulk Orders & Custom Designs
                </h2>
                <p class="text-slate-400 text-lg mb-8 max-w-2xl mx-auto">
                    Need merch for your team? We offer custom designs and bulk discounts for security teams and events.
                </p>
                <a
                    href="/contact"
                    class="inline-block bg-emerald-500 hover:bg-emerald-400 text-black px-8 py-4 rounded-xl font-bold text-lg transition-all glow-primary"
                >
                    Contact Us
                </a>
            </div>
        </section>
    </main>
</Layout>
