---
import { getCollection, getEntry } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';

const { slug } = Astro.params;
if (!slug) return Astro.redirect('/blog');

const entry = await getEntry('blog', slug);
if (!entry) return Astro.redirect('/blog');

const { Content } = await entry.render();
const { title, description, pubDate, author, category, tags, image } = entry.data;

const formattedDate = pubDate.toLocaleDateString('en-US', {
  year: 'numeric', month: 'long', day: 'numeric'
});

const readTime = Math.ceil(entry.body.split(' ').length / 200);

// Posts relacionados — misma categoría primero, luego otros, excluyendo el actual
const allPosts = (await getCollection('blog')).sort(
  (a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime()
);
const related = [
  ...allPosts.filter(p => p.slug !== slug && p.data.category === category),
  ...allPosts.filter(p => p.slug !== slug && p.data.category !== category),
].slice(0, 3);
---

<Layout title={title} description={description}>
  <Fragment slot="head">
    <meta property="og:type" content="article" />
    <meta property="article:published_time" content={pubDate.toISOString()} />
    <meta property="article:author" content={author} />
    {tags.map(tag => <meta property="article:tag" content={tag} />)}
    {image && <meta property="og:image" content={image} />}

    <script define:vars={{ title, description }}>
      window.addEventListener('load', () => {
        const url = encodeURIComponent(window.location.href);
        const text = encodeURIComponent(title + ' — ' + description);
        const li = document.getElementById('share-linkedin');
        const tw = document.getElementById('share-twitter');
        const wa = document.getElementById('share-whatsapp');
        const cp = document.getElementById('copy-link');
        if (li) li.href = `https://www.linkedin.com/sharing/share-offsite/?url=${url}`;
        if (tw) tw.href = `https://x.com/intent/tweet?text=${text}&url=${url}`;
        if (wa) wa.href = `https://wa.me/?text=${text}%20${url}`;
        cp?.addEventListener('click', () => {
          navigator.clipboard.writeText(window.location.href).then(() => {
            if (cp) cp.textContent = '✅ Copied!';
            setTimeout(() => { if (cp) cp.textContent = 'Copy link'; }, 2000);
          });
        });
      });
    </script>

    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "Article",
      "headline": title,
      "description": description,
      "datePublished": pubDate.toISOString(),
      "author": { "@type": "Organization", "name": author },
      "publisher": { "@type": "Organization", "name": "AuraLink AI Security", "url": "https://auralink.live" },
      "image": image || "https://auralink.live/og-image.png",
      "url": `https://auralink.live/blog/${slug}`
    })} />
  </Fragment>

  <main class="min-h-screen bg-[#020617]">
    <Header currentPath="/blog" />

    <!-- Hero image full width con overlay -->
    {image ? (
      <div class="relative w-full h-[55vh] min-h-[380px] overflow-hidden">
        <img src={image} alt={title} class="w-full h-full object-cover" loading="eager" />
        <div class="absolute inset-0 bg-gradient-to-t from-[#020617] via-[#020617]/60 to-transparent"></div>

        <!-- Meta sobre la imagen -->
        <div class="absolute bottom-0 left-0 right-0 container mx-auto px-6 pb-10 max-w-4xl">
          <div class="flex items-center gap-3 mb-5">
            <a href="/blog" class="text-slate-400 hover:text-emerald-400 text-sm transition-colors flex items-center gap-1">
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"/></svg>
              Intelligence
            </a>
            <span class="text-slate-700">/</span>
            <span class="px-3 py-1 bg-emerald-500/20 text-emerald-400 border border-emerald-500/30 rounded-full text-xs font-bold uppercase tracking-wider">
              {category}
            </span>
          </div>
          <h1 class="text-4xl md:text-6xl font-bold leading-tight text-white max-w-3xl">{title}</h1>
        </div>
      </div>
    ) : (
      <div class="container mx-auto px-6 pt-28 max-w-4xl">
        <div class="flex items-center gap-3 mb-8">
          <a href="/blog" class="text-slate-500 hover:text-emerald-400 text-sm transition-colors flex items-center gap-1">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"/></svg>
            Intelligence
          </a>
          <span class="text-slate-700">/</span>
          <span class="px-3 py-1 bg-emerald-500/10 text-emerald-400 rounded-full text-xs font-bold uppercase">{category}</span>
        </div>
        <h1 class="text-4xl md:text-6xl font-bold leading-tight">{title}</h1>
      </div>
    )}

    <!-- Meta bar -->
    <div class="container mx-auto px-6 max-w-4xl">
      <div class="py-8 border-b border-slate-800/60 flex flex-wrap items-center gap-6">
        <p class="text-slate-300 text-xl leading-relaxed max-w-2xl">{description}</p>
      </div>
      <div class="py-5 border-b border-slate-800/60 flex flex-wrap items-center gap-6 text-sm text-slate-500">
        <span class="flex items-center gap-2">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"/></svg>
          <strong class="text-slate-300">{author}</strong>
        </span>
        <span class="flex items-center gap-2">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"/></svg>
          {formattedDate}
        </span>
        <span class="flex items-center gap-2">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
          {readTime} min read
        </span>
      </div>
    </div>

    <!-- Contenido -->
    <article class="container mx-auto px-6 max-w-4xl pt-14 pb-24">
      <div class="
        prose prose-invert prose-emerald max-w-none
        prose-p:text-slate-300 prose-p:leading-[1.9] prose-p:text-[17px] prose-p:mb-8
        prose-h2:text-3xl prose-h2:font-bold prose-h2:text-white prose-h2:mt-16 prose-h2:mb-6
        prose-h3:text-xl prose-h3:font-bold prose-h3:text-emerald-400 prose-h3:mt-10 prose-h3:mb-4
        prose-strong:text-white prose-strong:font-semibold
        prose-a:text-emerald-400 prose-a:no-underline hover:prose-a:text-emerald-300
        prose-ul:my-6 prose-ul:space-y-3
        prose-li:text-slate-300 prose-li:text-[17px] prose-li:leading-relaxed
        prose-blockquote:border-l-4 prose-blockquote:border-emerald-500 prose-blockquote:pl-6 prose-blockquote:my-8 prose-blockquote:text-slate-300 prose-blockquote:text-xl prose-blockquote:italic
        prose-hr:border-slate-800 prose-hr:my-14
        prose-code:text-emerald-400 prose-code:bg-slate-900/80 prose-code:px-2 prose-code:py-0.5 prose-code:rounded prose-code:text-sm
      ">
        <Content />
      </div>

      <!-- Share -->
      <div class="mt-16 pt-10 border-t border-slate-800">
        <p class="text-slate-400 text-sm mb-5 font-medium uppercase tracking-wider">Share this article</p>
        <div class="flex flex-wrap gap-3">
          <a id="share-linkedin" href="#" target="_blank" rel="noopener noreferrer"
            class="flex items-center gap-2 px-5 py-2.5 bg-[#0A66C2] hover:bg-[#004182] text-white rounded-lg text-sm font-semibold transition-all">
            <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24"><path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 01-2.063-2.065 2.064 2.064 0 112.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/></svg>
            LinkedIn
          </a>
          <a id="share-twitter" href="#" target="_blank" rel="noopener noreferrer"
            class="flex items-center gap-2 px-5 py-2.5 bg-slate-800 hover:bg-slate-700 text-white rounded-lg text-sm font-semibold transition-all">
            <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24"><path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-4.714-6.231-5.401 6.231H2.744l7.737-8.835L1.254 2.25H8.08l4.253 5.622zm-1.161 17.52h1.833L7.084 4.126H5.117z"/></svg>
            X
          </a>
          <a id="share-whatsapp" href="#" target="_blank" rel="noopener noreferrer"
            class="flex items-center gap-2 px-5 py-2.5 bg-[#25D366] hover:bg-[#1ebe5d] text-white rounded-lg text-sm font-semibold transition-all">
            <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/></svg>
            WhatsApp
          </a>
          <button id="copy-link"
            class="flex items-center gap-2 px-5 py-2.5 bg-slate-800 hover:bg-slate-700 text-slate-300 rounded-lg text-sm font-semibold transition-all">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13.828 10.172a4 4 0 00-5.656 0l-4 4a4 4 0 105.656 5.656l1.102-1.101m-.758-4.899a4 4 0 005.656 0l4-4a4 4 0 00-5.656-5.656l-1.1 1.1"/></svg>
            Copy link
          </button>
        </div>
      </div>

      <!-- Tags -->
      {tags.length > 0 && (
        <div class="mt-10 flex flex-wrap gap-2">
          {tags.map(tag => (
            <span class="px-3 py-1.5 bg-slate-800/80 text-slate-500 rounded-full text-xs tracking-wide">#{tag}</span>
          ))}
        </div>
      )}

      <!-- More articles -->
      {related.length > 0 && (
        <div class="mt-16 pt-12 border-t border-slate-800">
          <h3 class="text-xl font-bold mb-8 text-white">More Articles</h3>
          <div class="grid sm:grid-cols-3 gap-5">
            {related.map(post => (
              <a href={`/blog/${post.slug}`} class="group block bg-slate-900/50 border border-slate-800 hover:border-emerald-500/40 rounded-2xl overflow-hidden transition-all hover:-translate-y-1">
                {post.data.image && (
                  <div class="w-full h-36 overflow-hidden">
                    <img src={post.data.image} alt={post.data.title} class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" loading="lazy"/>
                  </div>
                )}
                <div class="p-5">
                  <span class="text-xs text-slate-500 mb-2 block">{post.data.category}</span>
                  <h4 class="font-bold text-white text-sm leading-snug group-hover:text-emerald-400 transition-colors line-clamp-2">{post.data.title}</h4>
                </div>
              </a>
            ))}
          </div>
        </div>
      )}

      <!-- CTA -->
      <div class="mt-16 p-10 bg-gradient-to-br from-emerald-500/10 to-cyan-500/10 border border-emerald-500/20 rounded-3xl text-center">
        <p class="text-emerald-400 text-xs font-bold uppercase tracking-widest mb-4">AuraLink AI Security</p>
        <h3 class="text-3xl font-bold mb-4">Is Your Business Protected?</h3>
        <p class="text-slate-400 text-lg mb-8 max-w-lg mx-auto">Run a free AI-powered security scan — instant results, no credit card required.</p>
        <div class="flex flex-col sm:flex-row gap-4 justify-center">
          <a href="/#scanner" class="bg-emerald-500 hover:bg-emerald-400 text-black px-8 py-3.5 rounded-xl font-bold transition-all hover:scale-105">
            Free Security Scan
          </a>
          <a href="/contact" class="border border-emerald-500/50 text-emerald-400 px-8 py-3.5 rounded-xl font-bold hover:bg-emerald-500/10 transition-all">
            Talk to an Expert
          </a>
        </div>
      </div>
    </article>
  </main>
</Layout>
