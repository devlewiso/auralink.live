---
interface Props {
    currentPath?: string;
}

const { currentPath = "/" } = Astro.props;
---

<nav class="container mx-auto px-6 py-8 flex justify-between items-center relative z-50">
    <!-- Logo -->
    <a href="/" class="flex items-center space-x-2">
        <div class="w-8 h-8 bg-emerald-500 rounded-lg flex items-center justify-center glow-primary">
            <span class="text-black font-bold">A</span>
        </div>
        <span class="text-xl font-bold tracking-tight">
            Aura<span class="text-emerald-500">Link</span>
        </span>
    </a>

    <!-- Desktop menu -->
    <div class="hidden md:flex space-x-8 text-sm font-medium text-slate-400">
        <a href="/services" class:list={["hover:text-emerald-400 transition-colors", currentPath === "/services" && "text-emerald-400"]}>Services</a>
        <a href="/products" class:list={["hover:text-emerald-400 transition-colors", currentPath === "/products" && "text-emerald-400"]}>Products</a>
        <a href="/pricing"  class:list={["hover:text-emerald-400 transition-colors", currentPath === "/pricing"  && "text-emerald-400"]}>Pricing</a>
        <a href="/about"    class:list={["hover:text-emerald-400 transition-colors", currentPath === "/about"    && "text-emerald-400"]}>About</a>
        <a href="/blog"     class:list={["hover:text-emerald-400 transition-colors", currentPath === "/blog"     && "text-emerald-400"]}>Intelligence</a>
    </div>

    <!-- Desktop CTA -->
    <a href="/contact" class="hidden md:inline-block bg-emerald-500 hover:bg-emerald-400 text-black px-6 py-2 rounded-full font-bold text-sm transition-all transform hover:scale-105 active:scale-95 glow-primary">
        Request Audit
    </a>

    <!-- Mobile: hamburger + CTA -->
    <div class="flex items-center gap-3 md:hidden">
        <a href="/contact" class="bg-emerald-500 hover:bg-emerald-400 text-black px-4 py-2 rounded-full font-bold text-xs transition-all glow-primary">
            Audit
        </a>
        <button id="menu-toggle" aria-label="Open menu" class="text-slate-400 hover:text-white transition-colors p-1">
            <svg id="icon-open" class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"/>
            </svg>
            <svg id="icon-close" class="w-6 h-6 hidden" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/>
            </svg>
        </button>
    </div>
</nav>

<!-- Mobile menu dropdown -->
<div id="mobile-menu" class="hidden md:hidden absolute top-0 left-0 right-0 z-40 bg-[#020617]/95 backdrop-blur-md border-b border-slate-800 pt-24 pb-8 px-6">
    <div class="flex flex-col space-y-6 text-base font-medium">
        <a href="/services"    class:list={["transition-colors hover:text-emerald-400", currentPath === "/services"    ? "text-emerald-400" : "text-slate-300"]}>Services</a>
        <a href="/products"    class:list={["transition-colors hover:text-emerald-400", currentPath === "/products"    ? "text-emerald-400" : "text-slate-300"]}>Products</a>
        <a href="/pricing"     class:list={["transition-colors hover:text-emerald-400", currentPath === "/pricing"     ? "text-emerald-400" : "text-slate-300"]}>Pricing</a>
        <a href="/about"       class:list={["transition-colors hover:text-emerald-400", currentPath === "/about"       ? "text-emerald-400" : "text-slate-300"]}>About</a>
        <a href="/blog"        class:list={["transition-colors hover:text-emerald-400", currentPath === "/blog"        ? "text-emerald-400" : "text-slate-300"]}>Intelligence</a>
        <a href="/contact"     class:list={["transition-colors hover:text-emerald-400", currentPath === "/contact"     ? "text-emerald-400" : "text-slate-300"]}>Contact</a>
        <a href="/contact" class="mt-2 block w-full text-center bg-emerald-500 hover:bg-emerald-400 text-black px-6 py-3 rounded-xl font-bold transition-all">
            Request Audit
        </a>
    </div>
</div>

<script>
    const toggle = document.getElementById('menu-toggle');
    const menu   = document.getElementById('mobile-menu');
    const iconOpen  = document.getElementById('icon-open');
    const iconClose = document.getElementById('icon-close');

    toggle?.addEventListener('click', () => {
        const isOpen = !menu?.classList.contains('hidden');
        menu?.classList.toggle('hidden', isOpen);
        iconOpen?.classList.toggle('hidden', !isOpen);
        iconClose?.classList.toggle('hidden', isOpen);
    });

    // Cerrar al hacer click en un link
    menu?.querySelectorAll('a').forEach(link => {
        link.addEventListener('click', () => {
            menu.classList.add('hidden');
            iconOpen?.classList.remove('hidden');
            iconClose?.classList.add('hidden');
        });
    });
</script>

<style>
    .glow-primary { box-shadow: 0 0 20px rgba(16, 185, 129, 0.3); }
</style>
